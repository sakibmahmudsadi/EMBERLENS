# Copy to .env locally. Never commit .env or paste real secrets into prompts.
# NASA FIRMS MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=replace_with_your_key

# Application settings (proposed; align with the implemented configuration system)
APP_ENV=development
APP_NAME=EMBERLENS
LOG_LEVEL=INFO

# Database: use a local Postgres/PostGIS instance if the selected architecture adopts it.
DATABASE_URL=postgresql+psycopg://emberlens:change_me@localhost:5432/emberlens

# Storage paths. Keep source and derived data separated.
DATA_ROOT=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
CURATED_DATA_DIR=./data/curated
SAMPLE_DATA_DIR=./data/samples

# CORS should be restricted to the real frontend origin(s) before deployment.
FRONTEND_ORIGIN=http://localhost:5173
