# Needed only when running the FIRMS acquisition/register scripts.
# Do not put this value in the browser or container image.
NASA_FIRMS_MAP_KEY=replace_with_your_key

# Local API/database settings (the Docker Compose service sets its own container paths).
EMBERLENS_DB=./backend/emberlens-bangladesh.duckdb
DATA_ROOT=./data
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EMBERLENS_AOI_IDS=bangladesh-bd

# Local Vite development proxy target. Defaults to http://127.0.0.1:8000.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Docker Compose settings. deploy-data must contain the validated
# emberlens-bangladesh.duckdb file; it is not copied into the image.
EMBERLENS_DATA_DIR=./deploy-data
WEB_PORT=8080
EMBERLENS_UID=1000
EMBERLENS_GID=1000
